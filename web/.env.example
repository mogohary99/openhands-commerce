# Copy to web/.env.local (git-ignored). SANDBOX credentials only — the PayPal base URL is hard-coded to sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from your sandbox app's webhook settings. Without it the webhook endpoint rejects every event.
PAYPAL_WEBHOOK_ID=
# Optional. Without it, OpenHands uses its rule-based parser and explanations (and says so on screen).
ANTHROPIC_API_KEY=
# Public origin PayPal returns the buyer to after approval.
APP_BASE_URL=http://localhost:3000
# Optional, only for the live buyer E2E test (sandbox *personal* account from the developer dashboard).
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=
# Where the SQLite database lives. Hosted: a persistent disk path, e.g. /var/data/openhands.sqlite
DATABASE_PATH=
# Claude request timeout before falling back to rules (default 12000).
AI_TIMEOUT_MS=
