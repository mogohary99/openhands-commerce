{
  "name": "openhands-commerce",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --conditions=react-server --import tsx --test test/unit/*.test.ts",
    "test:e2e": "node --env-file-if-exists=.env.local ./node_modules/.bin/playwright test",
    "test:all": "npm run typecheck && npm test && npm run test:live && npm run build && npm run test:e2e",
    "test:live": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx --test test/live/*.test.ts",
    "purchase:manual": "MANUAL_PURCHASE=1 node --env-file-if-exists=.env.local ./node_modules/.bin/playwright test manual-purchase.spec.ts --headed --reporter=list"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "better-sqlite3": "12.11.1",
    "next": "16.4.2",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
